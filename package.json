{
  "name": "@ordin/zkyc-core-reference",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic local zKYC authority reference core",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ordin-systems/zkyc-core.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "fixtures"
  ],
  "scripts": {
    "format:check": "node scripts/format-check.mjs",
    "security:check": "node scripts/security-check.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test dist/test/acceptance.test.js",
    "build": "tsc",
    "verify": "npm run format:check && npm run security:check && npm run typecheck && npm test && npm run build && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
