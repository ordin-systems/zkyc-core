{
  "name": "@ordin/zkyc-core-api-reference",
  "version": "0.3.1",
  "private": true,
  "description": "Reference-only Hono transport adapter for the deterministic zKYC core",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/*.test.js",
    "build": "node ../../scripts/clean.mjs dist && tsc",
    "start": "node dist/src/server.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "hono": "4.13.1"
  },
  "peerDependencies": {
    "@ordin/zkyc-core-reference": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "typescript": "5.8.3"
  }
}
